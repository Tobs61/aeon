{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aeon",
  "version": "0.1.15",
  "identifier": "com.kael.aeon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "aeon",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "aeon.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/aeon.svg": "icons/icon.svg"
        },
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk"
        ]
      }
    }
  }
}
